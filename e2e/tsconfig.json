{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@webslicer/shared": ["../shared/src/index.ts"],
      "@web/*": ["../web/src/*"]
    },
    "types": ["node"]
  },
  "include": ["../playwright.config.ts", "**/*.ts"]
}
